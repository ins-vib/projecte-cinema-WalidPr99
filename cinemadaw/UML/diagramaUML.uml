@startuml
skinparam classAttributeIconSize 0
hide empty members

title Cinemadaw - Diagrama de classes

class Cinema {
	- id: Long
	- name: String
	- address: String
	- city: String
	- postalCode: String
	- rooms: List<Room>
}

class Room {
	- id: Long
	- name: String
	- capacity: int
	- cinema: Cinema
	- seats: List<Seat>
}

class Seat {
	- id: Long
	- seatRow: String
	- number: int
	- x: int
	- y: int
	- type: SeatType
	- state: boolean
	- room: Room
}

class Movie {
	- id: Long
	- title: String
	- duration: int
	- genre: String
	- description: String
	- releaseDate: LocalDate
}

class Screening {
	- id: Long
	- dateTime: LocalDateTime
	- price: double
	- movie: Movie
	- room: Room
}

class Comanda {
	- id: Long
	- dateTime: LocalDateTime
	- totalAmount: double
	- clientName: String
	- email: String
	- status: OrderStatus
	- tickets: List<Ticket>
}

class Ticket {
	- id: Long
	- price: double
	- seat: Seat
	- screening: Screening
	- comanda: Comanda
}

class User {
	- id: Long
	- username: String
	- password: String
	- role: Role
}

class New {
	- headline: String
	- body: String
}

enum SeatType {
	Standard
	Premium
	Adapted
}

enum OrderStatus {
	PENDENT
	CONFIRMADA
	CANCELADA
}

enum Role {
	ADMIN
	CLIENT
}

class LoyaltyAccount {
	- id: Long
	- user: User
	- points: int
	- totalSpent: double
	- tier: LoyaltyTier
	- availableDiscount: double
	- createdAt: LocalDateTime
}

class PointTransaction {
	- id: Long
	- loyaltyAccount: LoyaltyAccount
	- comanda: Comanda
	- type: TransactionType
	- points: int
	- description: String
	- createdAt: LocalDateTime
}

enum LoyaltyTier {
	BRONZE
	SILVER
	GOLD
}

enum TransactionType {
	EARN
	REDEEM
}

Cinema "1" *-- "0..*" Room : rooms
Room "1" *-- "0..*" Seat : seats
Movie "1" <-- "0..*" Screening : movie
Room "1" <-- "0..*" Screening : room
Comanda "1" *-- "0..*" Ticket : tickets
Seat "1" <-- "0..*" Ticket : seat
Screening "1" <-- "0..*" Ticket : screening
Role "1" <-- "0..*" User : role
SeatType "1" <-- "0..*" Seat : type
OrderStatus "1" <-- "0..*" Comanda : status

User "1" <-- "1" LoyaltyAccount : user
LoyaltyAccount "1" *-- "0..*" PointTransaction : transactions
Comanda "1" <-- "0..*" PointTransaction : comanda
LoyaltyTier "1" <-- "0..*" LoyaltyAccount : tier
TransactionType "1" <-- "0..*" PointTransaction : type

@enduml
