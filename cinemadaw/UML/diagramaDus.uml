@startuml

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Visitant" as Visitor
actor "Usuari autenticat" as Auth
actor "Admin" as Admin
actor "Client" as Client

Auth <|-- Admin
Auth <|-- Client

rectangle "Cinema App"{

Visitor -- (Iniciar sessio)
Visitor -- (Registrar-se)
Visitor -- (Consultar noticies publiques)

Auth -- (Veure perfil)
Auth -- (Tancar sessio)
Auth -- (Consultar cinemes)
Auth -- (Consultar pellicules)
Auth -- (Consultar screenings)
Auth -- (Gestionar cookies)
Auth -- (Proves de sessio)

Admin -- (Gestionar cinemes)
Admin -- (Gestionar sales)
Admin -- (Gestionar seients)
Admin -- (Gestionar pellicules)
Admin -- (Gestionar screenings)

Client -- (Veure cartellera client)
Client -- (Veure noticies client)
Client -- (Seleccionar seients)
Client -- (Previsualitzar reserva)
Client -- (Afegir seients al carret)
Client -- (Gestionar carret)
Client -- (Finalitzar compra)
Client -- (Consultar comandes)
Client -- (Veure detall comanda)
Client -- (Veure panell fidelitat)
Client -- (Canviar punts per saldo)
Client -- (Veure historial punts)
Client -- (Aplicar descompte al carret)

(Previsualitzar reserva) .> (Seleccionar seients) : <<include>>
(Afegir seients al carret) .> (Seleccionar seients) : <<include>>
(Finalitzar compra) .> (Gestionar carret) : <<include>>
(Veure detall comanda) .> (Consultar comandes) : <<extend>>

(Canviar punts per saldo) .> (Veure panell fidelitat) : <<include>>
(Veure historial punts) .> (Veure panell fidelitat) : <<extend>>
(Aplicar descompte al carret) .> (Finalitzar compra) : <<include>>
(Finalitzar compra) .> (Veure panell fidelitat) : <<extend>>

}

@enduml